<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss_c" />
		<include src="s2r://panorama/styles/citadel_db_page_shared.vcss_c" />
		<include src="s2r://panorama/styles/citadel_db_page_profile_match_history.vcss_c" />
		<include src="s2r://panorama/styles/citadel_match_history_block_large.vcss_c" />
		<include src="s2r://panorama/styles/citadel_match_history_block_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_match_history.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/custom_match_history.vjs_c" />
	</scripts>
	<CitadelProfilePageMatchHistory class="DashboardPage" oncancel="CitadelNavigateBack();" dashboardclass="isShowingProfileMatchHistoryPage">
		<Panel id="MatchHistoryTitleBar">
			<Panel class="MatchHistoryTitle">
				<Label text="#Citadel_Profile_MatchHistory" />
			</Panel>
			<Panel id="CmhToggle">
				<Label id="CmhToggleLabel" text="Custom Matches" />
			</Panel>
			<DropDown id="ModeFilter" dropdownbodyposition="100% 100%" />
		</Panel>
		<Panel id="MatchListingLoading">
			<Label text="#Citadel_Profile_Loading" />
		</Panel>
		<Panel id="MatchListing" />
		<Panel id="CmhPanel">
			<Panel id="CmhOpenRow">
				<TextEntry id="CmhIdEntry" placeholder="Paste a match ID" unlocalized="true" maxchars="20" />
				<Panel id="CmhIdOpen">
					<Label text="Open" />
				</Panel>
			</Panel>
			<Label id="CmhStatus" text="" />
			<Panel id="CmhList" />
		</Panel>
		<Panel class="MatchHistoryFooter">
			<Panel id="PrevMatchPage" class="MatchHistoryButton" onactivate="CitadelProfileHistoryPrevPage();">
				<Label text="#Citadel_MatchPage_Prev" />
			</Panel>
			<Panel id="NextMatchPage" class="MatchHistoryButton" onactivate="CitadelProfileHistoryNextPage();">
				<Label text="#Citadel_MatchPage_Next" />
			</Panel>
		</Panel>
	</CitadelProfilePageMatchHistory>
</root>
